# ─────────────────────────────────────────────────────────────────────────────
# Параметры установки RoutineOps-сервера. БЫСТРЫЙ СТАРТ:
#   cp install.env.example install.env
#   nano install.env            # заполни PUBLIC_ADDR и ADMIN_*
#   ./install.sh                # без sudo, от пользователя в группе docker
#
# install.env лежит в .gitignore (в нём пароль администратора) — НЕ коммить его.
# Инлайновые переменные при запуске (VAR=... ./install.sh) переопределяют этот файл.
# ─────────────────────────────────────────────────────────────────────────────

# ============================ ОБЯЗАТЕЛЬНО ====================================

# Внешний адрес сервера — по нему к нему обращаются АГЕНТЫ и БРАУЗЕРЫ (IP или домен).
# За NAT/VPN это НЕ то, что отдаёт `hostname -I` (там внутренний IP): укажи внешний
# адрес ЯВНО, иначе enroll по внешнему адресу упадёт на TLS — он обязан быть в SAN
# сертификата. Внутренний IP хоста добавляется в SAN автоматически, его писать не надо.
#   PUBLIC_ADDR=203.0.113.10      # внешний IP
#   PUBLIC_ADDR=mdm.example.com   # домен
PUBLIC_ADDR=

# Первый администратор (создаётся при первом старте). Пароль обязан пройти политику
# сложности: 8+ символов, минимум 3 из 4 классов (строчные/ПРОПИСНЫЕ/цифры/спецсимволы),
# иначе админ молча не создастся и войти будет некем.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ======================= УСТАНОВКА ИЗ ОБРАЗОВ (комплект) =====================

# Адрес приватного реестра образов — ОБЯЗАТЕЛЕН, если рядом нет исходников (в каталоге
# нет Dockerfile). Выдаётся вендором вместе с логином/паролем и registry-ca.crt.
# Установка из исходников эту переменную игнорирует.
#ROUTINEOPS_REGISTRY=registry.example:5000

# ============================ ОПЦИОНАЛЬНО ====================================

# Доп. DNS-имя в SAN сертификата (если к серверу ходят и по IP, и по доменному имени,
# а PUBLIC_ADDR — это IP).
#SERVER_HOST=mdm.example.com

# SMTP для инвайтов и сброса пароля. Пустой SMTP_HOST = почта выключена.
# Порт↔TLS ДОЛЖНЫ совпадать: 587 = STARTTLS → SMTP_TLS=false; 465 = implicit TLS → SMTP_TLS=true.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=noreply@example.com
#SMTP_TLS=false

# Telegram-бот для алертов безопасности. Пусто = выключен.
#TELEGRAM_BOT_TOKEN=

# Secure-флаг на cookie сессий — ставь true, если фронт всегда за HTTPS.
#COOKIE_SECURE=true

# Хранение данных телеметрии и аудита (в днях).
#DATA_RETENTION_DAYS=7
#AUDIT_RETENTION_DAYS=365

# 🔴 Блок ниже (BUILD_TAGS / LICENSE_VENDOR_PUBKEY / ESCROW_RECIPIENT_FPR / DARWIN_AGENT) —
# это пины СБОРКИ. На установке из образов они не применимы: образ собран у вендора, а что
# в нём включено, решает лицензия. Заполнять их там нечего и незачем.
#
# Редакция сборки. Пусто = open-core (обычный путь). Значение идёт И в серверный образ,
# И в сборку агентов, которых раздаёт self-update: собрать сервер enterprise, а агентов
# без тега — значит получить парк, где фича не «выключена», а не скомпилирована.
# Расхождение ловится гейтом по собранному бинарю (docs/self-update.md), установка падает.
#BUILD_TAGS=enterprise

# Публичный ключ вендора — им enterprise-сервер проверяет подпись лицензии. Уезжает в
# образ ldflags'ами на СБОРКЕ, а не в окружение сервера: ключ, читаемый из env, подменяется
# в рантайме, и проверка лицензии обходится целиком. Сборка без него стартует во Free и
# отвергает ЛЮБУЮ лицензию с "server binary not pinned with vendor key" — отдельная ошибка
# ровно затем, чтобы не путать её с битой подписью.
#LICENSE_VENDOR_PUBKEY=

# Получатель эскроу FileVault: fpr age-ключа, на который macOS-агенты шифруют ключи
# восстановления. Приватная часть остаётся у владельца инсталляции. Значение считает
# enterprise-бинарь сервера: `routineops-server -escrow-fpr age1...`. Это стартовый пин —
# сменить получателя позже можно без пересборки агентов, публикацией подписанной записи.
#ESCROW_RECIPIENT_FPR=

# macOS-агент для enterprise-инсталляции. Лежащий в репозитории prebuilt ВСЕГДА open-core,
# поэтому при BUILD_TAGS=enterprise путь к бинарю из приватного релиз-канала обязателен
# (рядом с ним нужны файлы .sha256 и .version). Путь — относительно каталога установки.
#DARWIN_AGENT=enterprise/agent_darwin_arm64
